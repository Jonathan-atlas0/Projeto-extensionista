{
  "info": {
    "name": "FinEduca Comunidade - MVP Backend",
    "description": "Colecao basica para demonstrar cadastro, login, receitas, despesas, dashboard, relatorios e conteudos educativos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userEmail",
      "value": "usuario.demo@fineduca.local"
    },
    {
      "key": "userPassword",
      "value": "123456"
    },
    {
      "key": "adminEmail",
      "value": "admin@fineduca.local"
    },
    {
      "key": "adminPassword",
      "value": "123456"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "receitaCategoriaId",
      "value": "1"
    },
    {
      "key": "despesaCategoriaId",
      "value": "6"
    },
    {
      "key": "receitaId",
      "value": ""
    },
    {
      "key": "despesaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario Demo\",\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userPassword}}\"\n}"
        }
      }
    },
    {
      "name": "2 - Login usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{userPassword}}\"\n}"
        }
      }
    },
    {
      "name": "3 - Listar categorias",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/categorias"
      }
    },
    {
      "name": "4 - Criar receita",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('receitaId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/receitas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Salario\",\n  \"valor\": 1500.00,\n  \"data\": \"2026-05-10\",\n  \"categoriaId\": {{receitaCategoriaId}}\n}"
        }
      }
    },
    {
      "name": "5 - Criar despesa",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('despesaId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/despesas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"Mercado\",\n  \"valor\": 400.00,\n  \"data\": \"2026-05-12\",\n  \"categoriaId\": {{despesaCategoriaId}}\n}"
        }
      }
    },
    {
      "name": "6 - Dashboard mensal",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard?mes=5&ano=2026"
      }
    },
    {
      "name": "7 - Relatorio mensal",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/relatorios/mensal?mes=5&ano=2026"
      }
    },
    {
      "name": "8 - Listar conteudos publicos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/conteudos"
      }
    },
    {
      "name": "9 - Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminPassword}}\"\n}"
        }
      }
    },
    {
      "name": "10 - Admin cria conteudo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/conteudos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Reserva de emergencia\",\n  \"descricao\": \"Como comecar uma reserva com pouco dinheiro.\",\n  \"conteudo\": \"Separe uma pequena quantia todo mes antes de gastar com itens nao essenciais.\",\n  \"categoriaConteudo\": \"POUPANCA\",\n  \"nivelDificuldade\": \"BASICO\",\n  \"visivel\": true\n}"
        }
      }
    }
  ]
}
